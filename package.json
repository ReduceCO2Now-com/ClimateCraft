{
  "name": "climatecraft",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@minecraft/server": "^2.11.0",
    "@minecraft/server-ui": "^2.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "build": "node scripts/build/build.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,json,yaml,yml,md}": [
      "prettier --write"
    ]
  }
}
